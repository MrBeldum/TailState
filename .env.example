# Runtime-only settings. Tailscale credentials and the optional webhook secret are entered in the web UI.
TAILSTATE_CONTAINER_NAME=tailstate
TAILSTATE_IMAGE=ghcr.io/crypt0rr/tailstate:latest
TAILSTATE_BIND_ADDRESS=127.0.0.1
TAILSTATE_PORT=8080
TAILSTATE_MASTER_KEY_FILE=./secrets/tailstate_master_key
# Compose memory ceiling; raise only after sizing for your tailnet.
TAILSTATE_MEMORY_LIMIT=512m
TAILSTATE_COOKIE_SECURE=false
# Bearer token for /metrics. Required for Compose (a host request hits the
# Docker bridge, not loopback, so an empty token returns 401). Optional only
# for a standalone binary that scrapers reach on true loopback.
TAILSTATE_METRICS_TOKEN=
# Optional comma-separated proxy IPs/CIDRs; only these may supply X-Forwarded-For.
TAILSTATE_TRUSTED_PROXIES=
TAILSTATE_LOG_LEVEL=info
